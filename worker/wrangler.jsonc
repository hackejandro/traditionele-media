{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "commonplace-stream",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    { "binding": "COMMONPLACE" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "COLLECTOR", "class_name": "CommonplaceCollector" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CommonplaceCollector"] }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.01
  }
}
